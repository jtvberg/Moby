{
  "name": "moby",
  "version": "0.9.9",
  "description": "It will task you",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "debug": "electron --inspect=6969 .",
    "break": "electron --inspect-brk=6969 .",
    "build": "electron-builder -m",
    "release": "electron-builder -m -p 'onTagOrDraft'"
  },
  "repository": "https://github.com/jtvberg/Moby",
  "homepage": "https://github.com/jtvberg/Moby",
  "keywords": [
    "Electron",
    "task",
    "Kanban"
  ],
  "author": "jtvberg",
  "license": "CC0-1.0",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-log": "^5.4.2",
    "electron-notarize": "^1.2.2",
    "electron-reload": "^1.5.0",
    "eslint": "^9.33.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.0",
    "@octokit/rest": "^19.0.13",
    "bootstrap": "^4.6.2",
    "custom-electron-titlebar": "^4.2.8",
    "electron-updater": "^6.6.2",
    "jquery": "^3.7.1",
    "popper.js": "^1.16.1",
    "rally": "^2.1.3",
    "servicenow-rest-api": "^1.2.2"
  },
  "build": {
    "appId": "com.jtvberg.moby",
    "publish": {
      "provider": "github"
    },
    "afterSign": "./build/afterSign.js",
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "certificateFile": "private/jtvberg.p12",
      "certificatePassword": "",
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "category": "Utility"
    }
  }
}
